{
  "name": "taupe",
  "productName": "Taupe",
  "version": "1.2.0",
  "description": "Fast disk space explorer for macOS and Windows, with an AI assistant (Claude / ChatGPT).",
  "type": "module",
  "main": "electron/main.mjs",
  "author": "17Sx",
  "license": "MIT",
  "homepage": "https://github.com/17Sx/taupe",
  "repository": {
    "type": "git",
    "url": "https://github.com/17Sx/taupe.git"
  },
  "bugs": {
    "url": "https://github.com/17Sx/taupe/issues"
  },
  "keywords": [
    "disk-usage",
    "disk-space",
    "treemap",
    "macos",
    "windows",
    "electron",
    "claude",
    "chatgpt"
  ],
  "scripts": {
    "start": "electron .",
    "dev:web": "bun src/server.mjs",
    "check": "bun --bun eslint . && bun --bun tsc -p tsconfig.json && bun --bun tsc -p tsconfig.ui.json",
    "lint": "bun --bun eslint .",
    "test": "bun scripts/ai-args-test.mjs && bun scripts/update-test.mjs && bun scripts/smoke.mjs && bun scripts/mcp-test.mjs",
    "icons": "electron scripts/make-icon.mjs",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
