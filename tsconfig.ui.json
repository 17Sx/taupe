{
  // Type-checks the UI (public/): classic scripts sharing one global scope (i18n.js, then app.js), not modules
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2024",
    "module": "esnext",
    "moduleDetection": "legacy",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": [],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["public/*.js"]
}
